# ============================================================
# FILE: .env.example
# PURPOSE: This is a TEMPLATE showing what your .env file
# should look like. 
#
# HOW TO USE:
# 1. Copy this file and rename the copy to exactly: .env
# 2. Replace the placeholder values with your real values
# 3. NEVER commit your real .env file to GitHub — it contains
#    sensitive credentials. It is already listed in .gitignore.
# ============================================================

# MONGO_URI: Your MongoDB connection string.
#
# Option A — Local MongoDB (if MongoDB is installed on your computer):
MONGO_URI=mongodb://localhost:27017/todoapp
#
# Option B — MongoDB Atlas (free cloud database):
# 1. Go to mongodb.com/atlas and create a free account
# 2. Create a cluster → Connect → Connect your application
# 3. Copy the connection string and paste it here
# 4. Replace <password> with your actual database password
# MONGO_URI=mongodb+srv://youruser:<password>@cluster0.xxxxx.mongodb.net/todoapp

# PORT: The port your Express server runs on.
# 5000 is the standard convention for Express backends.
# Your React frontend runs on 3000 — they must be different.
PORT=5000
